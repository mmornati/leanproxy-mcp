{
  "name": "leanproxy-cost",
  "displayName": "LeanProxy Cost Monitor",
  "description": "Token savings from LeanProxy (today and week-to-date) in your VS Code status bar",
  "version": "0.1.0",
  "publisher": "leanproxy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mmornati/leanproxy-mcp"
  },
  "bugs": {
    "url": "https://github.com/mmornati/leanproxy-mcp/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "leanproxy",
    "ai",
    "tokens",
    "savings",
    "monitoring"
  ],
  "icon": "icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "leanproxy.openCostPanel",
        "title": "LeanProxy: Open Cost Panel"
      },
      {
        "command": "leanproxy.refreshStatusBar",
        "title": "LeanProxy: Refresh Status Bar"
      },
      {
        "command": "leanproxy.setMetricsToken",
        "title": "LeanProxy: Set Metrics Token"
      }
    ],
    "configuration": {
      "title": "LeanProxy Cost Monitor",
      "properties": {
        "leanproxy.metricsEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:9091/metrics",
          "description": "URL of the LeanProxy metrics endpoint: the address given to --metrics-bind (serve or server run) plus /metrics. Not the dashboard's port (9090). Set the --metrics-token, if any, with \"LeanProxy: Set Metrics Token\"."
        },
        "leanproxy.pollInterval": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "description": "Polling interval in milliseconds, for the status bar and the panel. The proxy records a new usage snapshot every 5 seconds."
        },
        "leanproxy.currencySymbol": {
          "type": "string",
          "default": "$",
          "description": "Currency symbol for the estimated cost saved"
        },
        "leanproxy.tokenCostPer1000": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Your price per 1000 tokens, used to show an estimated cost saved. 0 (the default) shows tokens only: LeanProxy has no built-in price table."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && tsc -p src/webview/tsconfig.json",
    "compile:ext": "tsc -p ./",
    "compile:webview": "tsc -p src/webview/tsconfig.json",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.0.0",
    "mocha": "^10.8.0",
    "typescript": "^5.7.0"
  }
}
